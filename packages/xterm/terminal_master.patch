+  /// SGR attribute written with colon separated sub-parameters.
+  void _sgrHandleSubParams(int param, List<int> subParams) {
+    switch (param) {
+      case 4:
+        // Underline styles (double, curly, dotted, ...) are drawn as a
+        // single underline; `4:0` turns the underline off.
+        if (subParams.isNotEmpty && subParams[0] == 0) {
+          return handler.unsetCursorUnderline();
+        }
+        return handler.setCursorUnderline();
+      case 38:
+      case 48:
+        final isForeground = param == 38;
+        if (subParams.length >= 2 && subParams[0] == 5) {
+          return isForeground
+              ? handler.setForegroundColor256(subParams[1])
+              : handler.setBackgroundColor256(subParams[1]);
+        }
+        if (subParams.length >= 4 && subParams[0] == 2) {
+          // `2:r:g:b` or `2:<color space>:r:g:b[:...]`.
+          final offset = subParams.length == 4 ? 1 : 2;
+          final r = subParams[offset];
+          final g = subParams[offset + 1];
+          final b = subParams[offset + 2];
+          return isForeground
+              ? handler.setForegroundColorRgb(r, g, b)
+              : handler.setBackgroundColorRgb(r, g, b);
+        }
+        return handler.unsupportedStyle(param);
+      default:
+        // E.g. `58:...` (underline color), which is not supported.
+        return handler.unsupportedStyle(param);
+    }
+  }
