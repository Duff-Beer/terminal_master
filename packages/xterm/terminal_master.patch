+  /// variants the handlers actually distinguish are dispatched.
+  bool _isSupportedCsiVariant() {
+    if (_csi.hasIntermediates) return false;
+
+    switch (_csi.prefix) {
+      case null:
+        return true;
+      case Ascii.questionMark:
+        return const [Ascii.h, Ascii.l, Ascii.J, Ascii.K, Ascii.n]
+            .contains(_csi.finalByte);
+      case Ascii.greaterThan:
+      case Ascii.equal:
+        return _csi.finalByte == Ascii.c;
+      default:
+        return false;
+    }
+  }
